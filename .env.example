# Local development only. Copy to .env; never commit real credentials.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional locally: an ephemeral secret is generated if omitted.
# Set a unique, stable SECRET_KEY in deployed environments.
# SECRET_KEY=
# SQLite is the default. PostgreSQL requires requirements-postgres.txt.
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/customjsonview
